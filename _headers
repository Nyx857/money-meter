# 页面、manifest 和 service worker 每次校验，保证新版本能拿到
/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

# 图片类资源改名才变内容，可以长缓存
/icon-*.png
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable
